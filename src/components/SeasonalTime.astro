---
import type { SeasonalTime } from "../models/Club";
import { formatMonthRange } from "../utils/time";

interface Props {
  time: string | SeasonalTime[];
}

const { time } = Astro.props;
const isSeasonal = Array.isArray(time);
---

{
  isSeasonal ? (
    <span
      class="seasonal-time"
      data-seasonal-times={JSON.stringify(time)}
    >
      {(time as SeasonalTime[]).map((t, i) => (
        <>
          {i > 0 && " / "}
          {t.time}
          <span class="seasonal-range">{formatMonthRange(t.from, t.to)}</span>
        </>
      ))}
    </span>
  ) : (
    <span>{time}</span>
  )
}

<style>
  .seasonal-time {
    white-space: nowrap;
  }
  .seasonal-range {
    display: inline-block;
    margin-left: 0.4em;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mute);
    vertical-align: middle;
  }
</style>

<script>
  import { currentMonth, isMonthInRange } from "../utils/time";

  function resolveSeasonal() {
    const month = currentMonth();

    document.querySelectorAll<HTMLSpanElement>(".seasonal-time").forEach((el) => {
      const raw = el.dataset.seasonalTimes;
      if (!raw) return;

      try {
        const times: { from: number; to: number; time: string }[] =
          JSON.parse(raw);
        const match = times.find((t) => isMonthInRange(month, t.from, t.to));
        if (match) {
          el.textContent = match.time;
        }
      } catch {
        // keep fallback text
      }
    });
  }

  resolveSeasonal();
  document.addEventListener("astro:after-swap", resolveSeasonal);
</script>
